# Copy this file to .env in your project and fill in only what you use. Never commit .env.
#
# Every key is optional. The website skill builds from your own photos without any of them,
# and uses the first image tool you already have (see references/images.md):
# GPT image in ChatGPT or the Codex CLI needs no key here.

# OpenAI Images API (GPT image). https://platform.openai.com/api-keys
OPENAI_API_KEY=

# fal.ai: many image models, including photo edits that keep a face. https://fal.ai/dashboard/keys
FAL_KEY=

# kie.ai: used by cinematic mode (cinematic/scripts/kie.mjs) for stills and short video clips.
# Get a key at https://kie.ai
#
# Cost, so it is not a surprise. Published rates are 28 credits per still and
# 160 credits per 5-second clip. A modest six-act page is around 520 credits. A
# ten-leg continuous-world flight is closer to 2,000 credits at those rates,
# though observed billing has run well under the published numbers.
KIE_AI_API_KEY=
